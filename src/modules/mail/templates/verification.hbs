<!-- Rename file ini menjadi verification.hbs di folder templates -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7fa; color: #333333;">
    <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
        <!-- Header -->
        <tr>
            <td style="padding: 40px 20px; text-align: center; background-color: #2563eb;">
                <h1 style="margin: 0; color: #ffffff; font-size: 28px; letter-spacing: 1px;">JOB BOARD</h1>
            </td>
        </tr>

        <!-- Main Content -->
        <tr>
            <td style="padding: 40px 30px;">
                <h2 style="margin-top: 0; color: #1e293b; font-size: 22px;">Verifikasi Email Anda</h2>
                <p style="font-size: 16px; line-height: 1.6; color: #475569;">
                    Halo,
                </p>
                <p style="font-size: 16px; line-height: 1.6; color: #475569;">
                    Terima kasih telah mendaftar di Job Board. Silakan klik tombol di bawah ini untuk memverifikasi alamat email Anda (<strong>{{email}}</strong>) dan mengaktifkan akun Anda:
                </p>
                
                <!-- Button -->
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 30px 0;">
                    <tr>
                        <td align="center">
                            <a href="{{verifyUrl}}" 
                               style="background-color: #2563eb; color: #ffffff; padding: 15px 30px; text-decoration: none; font-weight: bold; border-radius: 5px; display: inline-block; font-size: 16px; box-shadow: 0 2px 5px rgba(37, 99, 235, 0.3);">
                                Verifikasi Email
                            </a>
                        </td>
                    </tr>
                </table>

                <p style="font-size: 14px; line-height: 1.6; color: #64748b; font-style: italic; border-left: 4px solid #e2e8f0; padding-left: 15px; margin: 25px 0;">
                    Tautan ini hanya akan berlaku selama <strong>60 menit</strong>. Jika Anda tidak merasa mendaftar di platform kami, silakan abaikan email ini.
                </p>

                <hr style="border: 0; border-top: 1px solid #f1f5f9; margin: 30px 0;">
                
                <!-- Troubleshooting Link -->
                <p style="font-size: 12px; line-height: 1.5; color: #94a3b8;">
                    Jika tombol di atas tidak berfungsi, Anda juga dapat menyalin dan menempelkan tautan berikut ke peramban (browser) Anda:
                </p>
                <p style="font-size: 12px; word-break: break-all; color: #2563eb;">
                    <a href="{{verifyUrl}}" style="color: #2563eb; text-decoration: underline;">{{verifyUrl}}</a>
                </p>
            </td>
        </tr>

        <!-- Footer -->
        <tr>
            <td style="padding: 20px; text-align: center; background-color: #f8fafc; border-top: 1px solid #f1f5f9;">
                <p style="margin: 0; font-size: 12px; color: #94a3b8;">
                    &copy; 2024 Job Board Team. All rights reserved.
                </p>
                <div style="margin-top: 10px;">
                    <a href="#" style="color: #64748b; text-decoration: none; font-size: 12px; margin: 0 5px;">Help Center</a> | 
                    <a href="#" style="color: #64748b; text-decoration: none; font-size: 12px; margin: 0 5px;">Privacy Policy</a>
                </div>
            </td>
        </tr>
    </table>
</body>
</html>
